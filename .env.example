# Postgres superuser for the pms database (used by the seeder).
POSTGRES_USER=pms
POSTGRES_PASSWORD=pms
POSTGRES_DB=pms
# Read-only login used by the MCP server.
PMS_READONLY_PASSWORD=pms_readonly
# Claude API key for the agent service.
ANTHROPIC_API_KEY=
# Optional overrides: PMS_CLAUDE_MODEL (default claude-sonnet-5-5; claude-opus-5-5 writes more analysis at ~2.4x the cost), PMS_CLAUDE_EFFORT (default medium).

# --- Optional: let people connect from their own Claude accounts (custom connector) ---
# Public HTTPS address of the MCP server; setting it turns sign-in on. The connector URL is
# ${PMS_PUBLIC_URL}/mcp. PMS_DOMAIN is the same host name, for the Caddy HTTPS proxy.
PMS_PUBLIC_URL=
PMS_DOMAIN=
# OpenID Connect app at your sign-in provider; its redirect URI is ${PMS_PUBLIC_URL}/oauth/callback.
# Google: https://accounts.google.com   Microsoft: https://login.microsoftonline.com/<tenant-id>/v2.0
PMS_OIDC_ISSUER=
PMS_OIDC_CLIENT_ID=
PMS_OIDC_CLIENT_SECRET=
# Who may connect (comma-separated). At least one is required when sign-in is on.
PMS_ALLOWED_EMAILS=
PMS_ALLOWED_DOMAINS=
# Lets the website's agent call the protected MCP server: openssl rand -hex 32
# Without PMS_PUBLIC_URL, setting it makes the MCP server private to the website's agent, which
# then passes on who is signed in to the website (needed for PMS_HOTEL_ACCESS with website users).
PMS_MCP_SERVICE_TOKEN=

# --- Optional: per-hotel access (enforced by the database) ---
# Rules separated by ";": `email = hotel codes`, `@domain = codes`, `* = codes` (everyone else);
# `*` as the codes means all hotels. Unset: everyone sees all hotels. Set: no matching rule, no hotels.
# Example: PMS_HOTEL_ACCESS=ann@hotel.example = LIS,OPO; @lisbon.example = LIS; * = *
PMS_HOTEL_ACCESS=

# --- Optional: website sign-in ---
# WEB_AUTH=oidc requires sign-in before chatting. It uses the provider and allowlist above
# (PMS_OIDC_ISSUER, PMS_ALLOWED_EMAILS/DOMAINS); register ${WEB_PUBLIC_URL}/auth/callback as a
# redirect URI in that provider app, or create a separate app and set WEB_OIDC_CLIENT_ID/SECRET.
WEB_AUTH=
# Where people open the website, e.g. http://localhost:5050 or https://reports.example.com
WEB_PUBLIC_URL=
# Encrypts session cookies (sessions last 12 hours): openssl rand -hex 32
WEB_SESSION_SECRET=
WEB_OIDC_CLIENT_ID=
WEB_OIDC_CLIENT_SECRET=
# true only when the website is behind a reverse proxy that sets X-Forwarded-For (rate limits per IP)
WEB_TRUST_PROXY=false

# --- Optional: share the website through a Cloudflare Tunnel (see README) ---
# Site-wide password asked by the browser, "user:password" (password of 12+ characters).
# Required for a quick tunnel unless WEB_AUTH=oidc is set.
WEB_PASSWORD=
# Named tunnel on your own domain: the token from Zero Trust → Networks → Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
